# ─────────────────────────────────────────────────────────────
# GLANZMOBIL – Umgebungsvariablen
# Kopiere diese Datei nach `.env.local` (lokal) bzw. trage die Werte
# im Hosting (z. B. Vercel → Project → Settings → Environment Variables) ein.
# Niemals echte Werte committen!
# ─────────────────────────────────────────────────────────────

# Öffentliche URL der Website (für Links in E-Mails, Sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.glanzmobil.at

# ── Datenbank ────────────────────────────────────────────────
# PostgreSQL-Verbindung (z. B. Supabase → Project Settings → Database → Connection string).
# Für Vercel/Serverless den "Transaction pooler" (Port 6543) verwenden.
# Supabase: ?sslmode=require&uselibpqcompat=true anhängen.
# Ohne DATABASE_URL nutzt `npm run dev` automatisch eine lokale Datenbank (PGlite, Ordner .data/).
# In Produktion ist eine Datenbank Pflicht – ohne sie werden KEINE Buchungen angenommen.
# Alternativ wird POSTGRES_URL gelesen (setzt z. B. die Neon-Integration von Vercel automatisch).
# Die Datenbank muss die Erweiterung "btree_gist" erlauben (Neon, Supabase und PostgreSQL ≥ 13: ja).
DATABASE_URL=
# Notschalter: GLANZMOBIL_DB=off ignoriert die Datenbank-Variablen. Die Website bleibt im Übergangsmodus
# erreichbar (Online-Buchung deaktiviert), ohne dass die Datenbank angefasst wird. Leer lassen im Normalbetrieb.
GLANZMOBIL_DB=

# ── Admin-Zugang ─────────────────────────────────────────────
# Benutzername für /admin
ADMIN_USERNAME=admin
# Passwort-Hash erzeugen mit:  npm run admin:hash -- "DeinSicheresPasswort"
ADMIN_PASSWORD_HASH=
# Zufälliger, geheimer Schlüssel (mind. 32 Zeichen) zum Signieren der Admin-Session.
# Erzeugen z. B. mit:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ── E-Mail-Versand (SMTP) ────────────────────────────────────
# Ohne SMTP-Konfiguration werden Buchungen trotzdem gespeichert, aber keine E-Mails versendet.
# Der Versandstatus ist im Admin-Bereich je Buchung sichtbar.
SMTP_HOST=
SMTP_PORT=587
# true für Port 465 (SMTPS), sonst false (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Absender, z. B. "GLANZMOBIL <termine@glanzmobil.at>"
MAIL_FROM=
# Empfänger der Admin-Benachrichtigungen bei neuen Buchungen
ADMIN_NOTIFICATION_EMAIL=

# ── Terminerinnerungen (Cron) ────────────────────────────────
# Geheimer Schlüssel für /api/cron/erinnerungen (mind. 16 zufällige Zeichen).
# Vercel Cron sendet ihn automatisch als "Authorization: Bearer …" (siehe vercel.json).
# Ohne CRON_SECRET ist der Endpunkt gesperrt und es werden keine Erinnerungen versendet.
CRON_SECRET=

# ── Optional: Benachrichtigungen per Webhook (SMS/WhatsApp vorbereitet) ──
# Bei neuen Buchungen, Anfragen, Stornierungen und Kontaktanfragen wird ein JSON-POST an diese URL
# gesendet – z. B. an Make/Zapier/n8n, die daraus eine SMS oder WhatsApp-Nachricht an dich erzeugen.
# Leer = deaktiviert. Es werden keine Zugangsdaten für SMS-/WhatsApp-Dienste im Projekt gespeichert.
NOTIFY_WEBHOOK_URL=
# Optionaler gemeinsamer Schlüssel; wird als Header "X-Glanzmobil-Signature" (HMAC-SHA256) mitgesendet.
NOTIFY_WEBHOOK_SECRET=
